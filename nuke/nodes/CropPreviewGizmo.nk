Root {
 inputs 0
 gsv  {
  __default__ {
  }
  __panel__ {
   tab {Main}
  }
 
}
 name /home/npittas/.nuke/inpaint/nuke/nodes/CropPreviewGizmo.nk
 fps 25
 format "1920 1080 0 0 1920 1080 1 HD_1080"
 proxy_type scale
 proxy_format "1024 778 0 0 1024 778 1 1K_Super_35(full-ap)"
 colorManagement Nuke
 workingSpaceLUT linear
 monitorLut sRGB
 monitorOutLUT rec709
 int8Lut sRGB
 int16Lut sRGB
 logLut Cineon
 floatLut linear
}
Input {
 inputs 0
 name Image
 xpos 180
 ypos -322
 number 1
}
Dot {
 name Dot2
 xpos 214
 ypos -222
}
set N302b8150 [stack 0]
Input {
 inputs 0
 name Mask
 xpos 70
 ypos -322
}
Switch {
 inputs 2
 name Switch1
 xpos 70
 ypos -226
}
Shuffle2 {
 fromInput1 {
  {0}
  B
 }
 fromInput2 {
  {0}
  B
 }
 mappings "4 rgba.alpha 0 3 rgba.alpha 0 3 rgba.alpha 0 3 rgba.red 0 0 rgba.alpha 0 3 rgba.green 0 1 rgba.alpha 0 3 rgba.blue 0 2"
 name ShuffleAlphaToRGB
 xpos 70
 ypos -130
}
CurveTool {
 operation "Auto Crop"
 ROI {0 0 1920 1080}
 autocropdata {{curve x1 932} {curve x1 0} {curve x1 1904} {curve x1 845}}
 intensitydata {{curve x1 0.0868136842} {curve x1 0.0868136842} {curve x1 0.0868136842} {curve x1 0.0868136842}}
 name CurveTool1
 xpos 70
 ypos -82
}
Crop {
 box {{"CurveTool1.autocropdata.x - (max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) - (CurveTool1.autocropdata.r - CurveTool1.autocropdata.x)) / 2"} {"CurveTool1.autocropdata.y - (max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) - (CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) / 2"} {"CurveTool1.autocropdata.x - (max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) - (CurveTool1.autocropdata.r - CurveTool1.autocropdata.x)) / 2 + max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y))"} {"CurveTool1.autocropdata.y - (max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) - (CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) / 2 + max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y))"}}
 reformat true
 name CropMask
 xpos 70
 ypos -34
}
Write {
 file_type png
 checkHashOnRead false
 ocioColorspace scene_linear
 display default
 view sRGB
 name WriteMask
 xpos 70
 ypos 62
}
push $N302b8150
Crop {
 box {{"CurveTool1.autocropdata.x - (max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) - (CurveTool1.autocropdata.r - CurveTool1.autocropdata.x)) / 2"} {"CurveTool1.autocropdata.y - (max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) - (CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) / 2"} {"CurveTool1.autocropdata.x - (max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) - (CurveTool1.autocropdata.r - CurveTool1.autocropdata.x)) / 2 + max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y))"} {"CurveTool1.autocropdata.y - (max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) - (CurveTool1.autocropdata.t - CurveTool1.autocropdata.y)) / 2 + max(1024, max(CurveTool1.autocropdata.r - CurveTool1.autocropdata.x, CurveTool1.autocropdata.t - CurveTool1.autocropdata.y))"}}
