#! /usr/bin/env nuke
## Minimal native Nuke gizmo shell.
##
## Do not define user knobs with addUserKnob here. The bridge knobs are created
## by comfyui_bridge.callbacks via Nuke's Python knob classes, so their types are
## correct across Nuke versions.

Gizmo {
 name ComfyUIBridge
 tile_color 0x355f8cff
 onCreate {from comfyui_bridge import callbacks
callbacks.initialize_this_node()}
}
Input {
 inputs 0
 name Input
 xpos 0
 ypos 0
}
Output {
 name Output1
 xpos 0
 ypos 100
}
Input {
 inputs 0
 name Mask
 xpos 200
 ypos 0
}
end_group
