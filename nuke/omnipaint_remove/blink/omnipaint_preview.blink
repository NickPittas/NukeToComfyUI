kernel OmniPaintPreview : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint, eEdgeClamped> src;
  Image<eRead, eAccessPoint, eEdgeClamped> mask;
  Image<eWrite> dst;

  param:
    int preview_enabled;
    int crop_x0;
    int crop_y0;
    int crop_x1;
    int crop_y1;
    float overlay_alpha;

  void define() {
    defineParam(preview_enabled, "preview_enabled", 1);
    defineParam(crop_x0, "crop_x0", 0);
    defineParam(crop_y0, "crop_y0", 0);
    defineParam(crop_x1, "crop_x1", 1024);
    defineParam(crop_y1, "crop_y1", 1024);
    defineParam(overlay_alpha, "overlay_alpha", 0.25f);
  }

  void process(int2 pos) {
    float4 s = src();
    if (preview_enabled == 0) { dst() = s; return; }

    float4 m = mask();
    float matte = max(max(m.x, m.y), max(m.z, m.w));
    int inside = (pos.x >= crop_x0 && pos.x < crop_x1 && pos.y >= crop_y0 && pos.y < crop_y1) ? 1 : 0;
    int border = (inside == 1 && (pos.x == crop_x0 || pos.x == crop_x1 - 1 || pos.y == crop_y0 || pos.y == crop_y1 - 1)) ? 1 : 0;

    float a = 0.0f;
    if (inside == 1) a = overlay_alpha * 0.35f;
    if (matte > 0.001f) a = overlay_alpha;
    if (border == 1) a = overlay_alpha;

    dst() = float4(s.x * (1.0f - a) + a,
                   s.y * (1.0f - a),
                   s.z * (1.0f - a),
                   s.w);
  }
};
